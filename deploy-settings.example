# 호스팅 서비스의 환경변수 화면에 설정합니다. 이 파일에는 실제 비밀값을 쓰지 마세요.
NOURISHON_ENV=staging
NOURISHON_ALLOWED_ORIGINS=https://your-test-service.example.com
NOURISHON_DATABASE_URL=postgresql://app-user:REPLACE_IN_HOSTING_SETTINGS@db.example.com/nourishon_staging?sslmode=require
NOURISHON_FOOD_DATA_PATH=/srv/nourishon-food/foods.json
NOURISHON_FRONTEND_DIST=/srv/nourishon/frontend/dist
# 빌드 때 식품 정제본을 비공개 GitHub Release에서 내려받을 때만 사용합니다.
NOURISHON_FOOD_RELEASE_REPO=your-account/your-private-food-repo
NOURISHON_FOOD_RELEASE_TAG=food-20261105
NOURISHON_FOOD_RELEASE_ASSET=food-data-20261105.tar.gz
NOURISHON_FOOD_RELEASE_SHA256=64자리-16진수-해시
NOURISHON_FOOD_RELEASE_TOKEN=REPLACE_IN_HOSTING_SETTINGS
# Render(Cloudflare 앞단) 뒤에서만 설정합니다. 직접 접속 가능한 서버에서 켜면 IP를 위조할 수 있습니다.
NOURISHON_CLIENT_IP_HEADER=cf-connecting-ip
